# Used by the API and the migration command when they run on the host.
# The Compose PostgreSQL uses trust authentication on loopback, so no password is needed.
DATABASE_URL=postgres://pooleno@127.0.0.1:55432/pooleno

HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# How long a request waits for an in-flight request with the same key, or for its
# symbol's sequence counter, before answering 409 or 503. Must be greater than zero.
ACCEPTANCE_LOCK_TIMEOUT_MS=1000
