# Used by the processes and commands that run on the host. Compose sets its own values.
# The Compose PostgreSQL uses trust authentication on loopback, so no password is needed.
DATABASE_URL=postgres://pooleno@127.0.0.1:55432/pooleno

HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# How long a request waits for an in-flight request with the same key, or for its
# symbol's sequence counter, before answering 409 or 503. Must be greater than zero.
ACCEPTANCE_LOCK_TIMEOUT_MS=1000

# The Compose Kafka advertises this address to the host, and needs no credentials.
KAFKA_BROKERS=127.0.0.1:59092
KAFKA_TOPIC=orders.accepted

# Publisher: how often to look for due events, and the delay before retrying a failed
# send, which doubles from the base up to the cap.
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_RETRY_BASE_MS=500
OUTBOX_RETRY_CAP_MS=30000

# Matching: a member silent for the session timeout loses its partitions. Kafka refuses
# a value below 6000 by default. The delay applies before restoring after a failure.
MATCHING_GROUP_ID=matching-v1
MATCHING_SESSION_TIMEOUT_MS=10000
MATCHING_RESTART_DELAY_MS=1000

# External role: the consumer group, and the same two settings as matching.
EXTERNAL_GROUP_ID=external-notification-v1
EXTERNAL_SESSION_TIMEOUT_MS=10000
EXTERNAL_RESTART_DELAY_MS=1000

# External role: where notifications go, the limit on one attempt, and how often to look
# for due jobs. The delay before a retry doubles from the base up to the cap, and the jitter
# removes up to that percentage of it at random. Once a job has used all its attempts, it fails.
EXTERNAL_API_URL=http://127.0.0.1:58080/v1/notifications
EXTERNAL_TIMEOUT_MS=5000
EXTERNAL_POLL_INTERVAL_MS=500
EXTERNAL_RETRY_BASE_MS=1000
EXTERNAL_RETRY_CAP_MS=300000
EXTERNAL_RETRY_JITTER_PERCENT=50
EXTERNAL_MAX_ATTEMPTS=400

# Every role: how long a shutdown may take before the process ends itself. Keep it below the
# supervisor's grace period, which is 10 s in compose.yaml.
SHUTDOWN_TIMEOUT_MS=8000

# Publisher, matching and external: where /health/live and /health/ready listen. The API serves
# them on PORT instead. A role's default port is 8081, 8082 or 8083, in that order, and
# setting HEALTH_PORT here would give them all the same one, so it is only an example.
HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8081

# Mock external API: where it listens, and the SQLite file that holds its effects.
MOCK_API_HOST=127.0.0.1
MOCK_API_PORT=58080
MOCK_API_DATABASE=mock-api.sqlite
